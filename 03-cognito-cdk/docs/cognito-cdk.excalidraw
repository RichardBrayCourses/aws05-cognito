      "versionNonce": 39613525,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1780574764139,
      "link": null,
      "locked": false,
      "text": "CALLBACK PAGE ... PREPARATION FOR API CALL IN STEP 3\n- load code verifier and state from browser storage\n- check state in address bar === state in storage (ensure data in address bar hasn't been tampered with)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CALLBACK PAGE ... PREPARATION FOR API CALL IN STEP 3\n- load code verifier and state from browser storage\n- check state in address bar === state in storage (ensure data in address bar hasn't been tampered with)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kI7W7ehzESmIUGzTPwNJG",
      "type": "rectangle",
      "x": 460.1898694673646,
      "y": 555.0528996613103,
      "width": 581.2983705582083,
      "height": 416.01328888009857,
      "angle": 0,
