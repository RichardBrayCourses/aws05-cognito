    {
      "id": "ma_ma6QA9PwTvNGe81y2g",
      "type": "text",
      "x": 502.8976362456351,
      "y": 586.5098305869172,
      "width": 495.02460388431314,
      "height": 340,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Xycho1ehK25KStPXkSD3B",
        "UPh_FkpptNv7C05roAus7"
      ],
      "frameId": null,
      "index": "c2Gn",
      "roundness": null,
      "seed": 588671822,
      "version": 345,
      "versionNonce": 64299445,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1780574764139,
      "link": null,
      "locked": false,
      "text": "Question: Why doesn’t Cognito simply return the tokens\nwhen redirecting back from the login page?\n\nAnswer: Because the data returned when redirecting back\nfrom the login page travels through the browser address\nbar and could potentially be seen by someone else.\n\nInstead, Cognito returns a temporary authorization code.\nThe application then sends this code back to Cognito\nusing a secure encrypted API call, together with the\noriginal code verifier that was generated before the\nlogin process began.\n\nCognito checks that the code verifier matches the code\nchallenge supplied earlier. If the check succeeds, the\nID token, access token and refresh token are returned to\nthe application in the API response.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Question: Why doesn’t Cognito simply return the tokens when redirecting back from the login page?\n\nAnswer: Because the data returned when redirecting back from the login page travels through the browser address bar and could potentially be seen by someone else.\n\nInstead, Cognito returns a temporary authorization code. The application then sends this code back to Cognito using a secure encrypted API call, together with the original code verifier that was generated before the login process began.\n\nCognito checks that the code verifier matches the code challenge supplied earlier. If the check succeeds, the ID token, access token and refresh token are returned to the application in the API response.",
      "autoResize": false,
      "lineHeight": 1.25
    },
